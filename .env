# Local/dev environment with ALL optional features turned on:
#  - Multi-account, role-based admin (SUPER_ADMIN / QUEUE_OPERATOR / AUDITOR)
#  - Partner/institutional bulk result API
#  - AI assistant (FAQ RAG chat + grievance-cluster labeling) — see
#    assistant-service section at the bottom. Leave ANTHROPIC_API_KEY
#    blank to keep the AI features gracefully disabled.
#
# Generated for LOCAL DEV ONLY. Never reuse these values, and never
# commit a real .env to version control.

TICKET_SIGNING_SECRET=***************************************************************e
ALLOWED_ORIGINS=********************0

# Legacy single key (used only if ADMIN_ACCOUNTS_JSON parsing fails).
ADMIN_API_KEY=*******************************x

# Real per-account roles — three named admins, three roles, one shared
# audit trail. Give each teammate their own key from this list instead
# of copy-pasting ADMIN_API_KEY around.
#   Priya (Ops)     -> SUPER_ADMIN     key: *******************************x
#   Raj (Operator)  -> QUEUE_OPERATOR  key: *******************************f
#   Meera (Auditor) -> AUDITOR         key: *******************************g
ADMIN_ACCOUNTS_JSON=[{"key":"*******************************x","name":"Priya (Ops)","role":"SUPER_ADMIN"},{"key":"*******************************f","name":"Raj (Operator)","role":"QUEUE_OPERATOR"},{"key":"*******************************g","name":"Meera (Auditor)","role":"AUDITOR"}]

# Partner/institutional bulk API — set (non-blank) to enable
# POST /api/partner/results/bulk. Blank disables it entirely.
PARTNER_API_KEY=*******************************9

PII_ENCRYPTION_KEY=***************************************************************i

POSTGRES_PASSWORD=***********************Q
RABBITMQ_USER=sarthi_mq
RABBITMQ_PASSWORD=***********************A

# ---- assistant-service (new) ------------------------------------------
# Anthropic API key for the AI FAQ assistant and grievance-cluster
# labeling. Leave blank to run the whole stack with AI features
# disabled — every other service works identically either way.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Copy this file to .env and fill in real values before any deployment
# beyond local dev. docker-compose.yml reads these automatically.
#
#   cp .env.example .env

# Signs/verifies the short-lived admission tickets that let a user past
# the waiting room into result-service. MUST be a long, random value in
# any real deployment (e.g. `openssl rand -base64 48`), and MUST be the
# same value queue-service and result-service both receive.
TICKET_SIGNING_SECRET=replace-with-a-long-random-value

# Comma-separated list of origins allowed to call the API / open the
# WebSocket. Set this to your actual deployed frontend URL(s).
ALLOWED_ORIGINS=********************0

# Required in the X-Admin-Key header to reach /api/admin/** (queue-service)
# and /api/grievances/admin/** (result-service). MUST be a long, random
# value in any real deployment — never share it with candidate-facing
# code or expose it in the frontend bundle.
ADMIN_API_KEY=replace-with-a-long-random-value

# Optional: real per-account admin roles instead of one shared key.
# JSON array — each entry needs key/name/role. Valid roles:
# SUPER_ADMIN (full access), QUEUE_OPERATOR (queue-service only: can
# tune the admission rate), AUDITOR (read-only everywhere). Leave unset
# to keep using ADMIN_API_KEY as a single SUPER_ADMIN account.
# ADMIN_ACCOUNTS_JSON=[{"key":"...","name":"Priya (Ops)","role":"SUPER_ADMIN"},{"key":"...","name":"Raj (Auditor)","role":"AUDITOR"}]

# Optional: enables the partner/institutional bulk result API
# (POST /api/partner/results/bulk with an X-Partner-Key header).
# Leave blank to keep this endpoint disabled entirely.
PARTNER_API_KEY=

# AES key used to encrypt roll numbers and grievance/feedback text at
# rest in Postgres (see PiiEncryptionService). Losing/rotating this key
# without a re-encryption pass makes existing encrypted rows
# unreadable — treat it with the same care as a database password.
PII_ENCRYPTION_KEY=replace-with-a-long-random-value

# Data-store credentials — change these before deploying anywhere
# reachable from outside your own machine. docker-compose.yml currently
# has local-dev defaults (sarthi/sarthi_pass, RabbitMQ guest/guest)
# hardcoded; override them here and update docker-compose.yml to read
# from these variables instead, the same way TICKET_SIGNING_SECRET does.
POSTGRES_PASSWORD=replace-with-a-strong-password
RABBITMQ_USER=replace-with-a-real-user
RABBITMQ_PASSWORD=replace-with-a-strong-password
